# Below are some examples on how to use bicep modules for this module
# Please login using az cli and set up destination subscripton

# az login
az account show

# **************************************************
# 1. Deploy module using requred parameters only. 
#
# - deploy resource group 
# - deploy keyvault
# - add secrest to the key vault

export location="uksouth"
export stackName="keyvault-secrets-requried-params"
export templateFile=modules/security/keyvault-secrest/examples/requaried-parameters/main.bicep
az stack sub create --name $stackName --location $location --template-file $templateFile --deny-settings-mode None --action-on-unmanage deleteAll


# **************************************************
# 2. Deploy module using all availbale paramaters. 
#
# - deploy resource group 
# - deploy keyvault
# - add secrest to the key vault with expiry date, not before date 

export location="uksouth"
export stackName="keyvault-secret-full-params"
export templateFile=modules/security/keyvault-secrets/examples/full-parameters/main.bicep
az stack sub create --name $stackName --location $location --template-file $templateFile --deny-settings-mode None --action-on-unmanage deleteAll
